# Set ONE of these. Claude is used if both are set.

# Claude (paid) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gemini (free tier, no card) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model to try first (falls back through several free models automatically)
# GEMINI_MODEL=gemini-3.6-flash

PORT=3789

# Honeypot decoy site (optional). The persona hands scammers this fake shop login.
# By default it's reachable on your Wi-Fi (phones on the same network can open it).
# To make it reachable from anywhere, run a tunnel (e.g. `cloudflared tunnel --url http://localhost:3789`)
# and put its URL here:
# HONEYPOT_PUBLIC_URL=https://your-tunnel.trycloudflare.com
# HONEYPOT_SHOP=Sri Lakshmi Textiles
# HONEYPOT_USER=lakshmi_admin
# HONEYPOT_PASS=Textiles@2026
